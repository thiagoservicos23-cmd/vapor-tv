{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vapor TV",
  "version": "1.0.0",
  "identifier": "com.vaportv.player",
  "build": {
    "frontendDist": "../www",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Vapor TV",
        "width": 1280,
        "height": 768,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
